# =============================================================================
# OLA SOCIAL — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local to the repository.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. PUBLIC / FRONTEND CONFIGURATION (VITE_*)
# These variables are bundled into client code and accessible to the browser.
# -----------------------------------------------------------------------------

# Supabase API URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Client Public Key (JWT token with anon role, protected by RLS)
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile Site Key (Public client-side widget key)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=

# -----------------------------------------------------------------------------
# 2. PRIVATE / SERVER-ONLY CONFIGURATION
# WARNING: SERVER_ONLY — NEVER EXPOSE IN CLIENT OR COMMIT TO REPOSITORY.
# Configure these in Supabase Edge Functions Secrets or CI/CD Secrets.
# -----------------------------------------------------------------------------

# Cloudflare Turnstile Secret Key (Used by Supabase Edge Function verify-turnstile)
# SERVER_ONLY — NEVER EXPOSE IN CLIENT
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Gemini AI API Key (Used for server-side assistance)
# SERVER_ONLY — NEVER EXPOSE IN CLIENT
GEMINI_API_KEY=

# Optional: Supabase Access Token (Used only in CI/CD pipeline to deploy Edge Functions)
# SERVER_ONLY — NEVER EXPOSE IN CLIENT
SUPABASE_ACCESS_TOKEN=
